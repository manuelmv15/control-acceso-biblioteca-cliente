/* ============ Biblioteca Kiosko — Estilos globales ============ */
/* Paleta calcada del sitio oficial ues.edu.sv: rojo institucional #8B0E13,
   casi-negro #1A171B (hover), texto gris #696969, fondos claros. */

QWidget {
    background-color: #F5F5F5;
    color: #111111;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 18px;
}

QLabel#titulo {
    font-size: 32px;
    font-weight: bold;
    color: #8B0E13;
    padding: 8px 0;
}

QLabel#subtitulo {
    font-size: 18px;
    color: #696969;
    padding: 4px 0;
}

QLabel#nombre-estudiante {
    font-size: 28px;
    font-weight: bold;
    color: #111111;
}

QLabel#timer {
    font-size: 48px;
    font-weight: bold;
    color: #8B0E13;
    letter-spacing: 4px;
}

QLabel#info {
    font-size: 15px;
    color: #696969;
}

QLabel#error {
    font-size: 15px;
    color: #8B0E13;
    padding: 4px;
}

QLineEdit {
    background-color: #F5F5F5;
    border: 2px solid #EEEEEE;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 22px;
    color: #111111;
    selection-background-color: #8B0E13;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #8B0E13;
    background-color: #ffffff;
}

QLineEdit:disabled {
    background-color: #EAEAEA;
    color: #9A9A9A;
    border-color: #EAEAEA;
}

QPushButton {
    background-color: #8B0E13;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 14px 32px;
    font-size: 18px;
    font-weight: bold;
    min-width: 160px;
}

QPushButton:hover { background-color: #1A171B; }
QPushButton:pressed { background-color: #000000; }

QPushButton#btn-secundario {
    background-color: #EDEDED;
    color: #111111;
    border: 2px solid #E0E0E0;
}

QPushButton#btn-secundario:hover { background-color: #E0E0E0; }

QPushButton#btn-cerrar-sesion {
    background-color: #8B0E13;
    color: white;
    font-size: 20px;
    padding: 16px 48px;
}

QPushButton#btn-cerrar-sesion:hover { background-color: #1A171B; }

QComboBox {
    background-color: #F5F5F5;
    border: 2px solid #EEEEEE;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 16px;
    color: #111111;
}

QComboBox:disabled {
    background-color: #EAEAEA;
    color: #9A9A9A;
}

QComboBox::drop-down { border: none; width: 30px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111111;
    selection-background-color: #8B0E13;
    selection-color: #ffffff;
    border: 1px solid #EEEEEE;
}

QRadioButton { font-size: 16px; spacing: 8px; }
QRadioButton::indicator { width: 20px; height: 20px; }

QFrame#separador {
    background-color: #EEEEEE;
    max-height: 1px;
    margin: 8px 0;
}
